{
	"schemaVersion": 1,
	"id": "block_custom_rules",
	"version": "${version}",
	"name": "Block Custom Rules",
	"description": "Per-block rules from resource packs: texture draw mode, face culling, sway, and sound categories with layered footsteps that replace Presence Footsteps.",
	"authors": [
		"kwangsoo"
	],
	"contact": {},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"kr.asmbl.block_custom_rules.BcrClient"
		],
		"modmenu": [
			"kr.asmbl.block_custom_rules.screen.BcrModMenu"
		]
	},
	"mixins": [
		{
			"config": "block_custom_rules.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.8",
		"java": ">=21",
		"fabric-command-api-v2": "*",
		"fabric-lifecycle-events-v1": "*",
		"fabric-resource-loader-v0": "*"
	},
	"breaks": {
		"block_render_rules": "*",
		"cull_pass": "*",
		"sway": "*",
		"presencefootsteps": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
