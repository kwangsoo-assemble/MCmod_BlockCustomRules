{
	"schemaVersion": 1,
	"id": "block_render_rules",
	"version": "${version}",
	"name": "Block Render Rules",
	"description": "Per-block render rules: how a block's texture is drawn (solid / cutout / translucent), whether it hides its neighbours' faces, and how much it sways when entities brush through it.",
	"authors": [
		"kwangsoo"
	],
	"contact": {},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"kr.asmbl.block_render_rules.BrrClient"
		],
		"modmenu": [
			"kr.asmbl.block_render_rules.screen.BrrModMenu"
		]
	},
	"mixins": [
		{
			"config": "block_render_rules.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.8",
		"java": ">=21",
		"fabric-command-api-v2": "*"
	},
	"breaks": {
		"cull_pass": "*",
		"sway": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
